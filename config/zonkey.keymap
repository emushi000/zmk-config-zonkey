#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define JP_BSLH  INT1                     // (backslash)

// new define
#define JP_EXCLAMATION  LS(N1)            // !
#define JP_QUESTION     LS(SLASH)         // ?
#define JP_HASH         LS(N3)            // #
#define JP_DOLLAR       LS(N4)            // $
#define JP_PERCENT      LS(N5)            // %


&mt {
    flavor = "hold-preferred";
    quick-tap-ms = <0>;
};

/ {
    macros {
        maCtrlScrlUp: ctrl_scroll_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &msc SCRL_UP >
                , <&macro_release &kp LCTRL>
                ;
        };

        maCtrlScrlDown: ctrl_scroll_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &msc SCRL_DOWN >
                , <&macro_release &kp LCTRL>
                ;
        };
    };


    behaviors {
        combos {
            compatible = "zmk,combos";

            //Left row1
            coEsc {
                bindings = <&kp ESC>;
                key-positions = <1 2>;
                layers = <0>;
            };

            coEnter {
                bindings = <&kp ENTER>;
                key-positions = <2 3>;
                layers = <0>;
            };

            coLang1 {
                bindings = <&kp LANG1>;
                key-positions = <1 3>;
                layers = <0>;
            };

            //Left row2
            coBs {
                bindings = <&kp BACKSPACE>;
                key-positions = <11 12>;
                layers = <0>;
            };

            coDel {
                bindings = <&kp DELETE>;
                key-positions = <12 13>;
                layers = <0>;
            };

            coGrave {
                bindings = <&kp GRAVE>;
                key-positions = <11 13>;
                layers = <0>;
            };

            //Left row3
            coF7 {
                bindings = <&kp F7>;
                key-positions = <24 25>;
                layers = <0>;
            };

            coF10 {
                bindings = <&kp F10>;
                key-positions = <25 26>;
                layers = <0>;
            };

            coLang2 {
                bindings = <&kp LANG2>;
                key-positions = <24 26>;
                layers = <0>;
            };

            //Right row1
            coPageUp {
                bindings = <&kp PAGE_UP>;
                key-positions = <6 7>;
                layers = <0>;
            };

            coPageDown {
                bindings = <&kp PAGE_DOWN>;
                key-positions = <7 8>;
                layers = <0>;
            };

            //Right row2
            coMB1 {
                bindings = <&mkp MB1>;
                key-positions = <18 19>;
                layers = <0>;
            };

            coMB2 {
                bindings = <&mkp MB2>;
                key-positions = <19 20>;
                layers = <0>;
            };

            coMB3 {
                bindings = <&mkp MB3>;
                key-positions = <18 20>;
                layers = <0>;
            };

            //Right row3
            coMB4 {
                bindings = <&mkp MB4>;
                key-positions = <30 31>;
                layers = <0>;
            };

            coMB5 {
                bindings = <&mkp MB5>;
                key-positions = <31 32>;
                layers = <0>;
            };
        };

        mo1: mo1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp JP_EXCLAMATION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo2: mo2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp AT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo3: mo3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N3>, <&kp JP_HASH>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo4: mo4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N4>, <&kp JP_DOLLAR>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo5: mo5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N5>, <&kp JP_PERCENT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo6: mo6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp CARET>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo7: mo7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp AMPS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo8: mo8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp ASTRK>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo9: mo9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp LPAR>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo0: mo0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp LS(N9)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moA: moA {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp UNDERSCORE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moB: moB {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp PLUS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moC: moC {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp INT3>, <&kp JP_PIPE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moD: moD {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp LBRC>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moE: moE {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&kp RBRC>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moF: moF {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp KP_PLUS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moG: moG {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp APOSTROPHE>, <&kp DQT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moH: moH {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSLASH>, <&kp TILDE2>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moI: moI {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_BSLH>, <&kp JP_UNDERSCORE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        macros {
            to_layer_0: to_layer_0 {
                compatible = "zmk,behavior-macro-one-param";
                #binding-cells = <1>;
                bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
                label = "TO_LAYER_0";
            };
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        // new behavior
        moColon: moColon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_COLON>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "MOCOLON";
        };

        moPgTabUp: moPgTabUp {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PAGE_UP>, <&kp LC(TAB)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "MOPGTABUP";
        };

        moPgTabDown: moPgTabDown {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PAGE_DOWN>, <&kp LC(LS(TAB))>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "MOPGTABDOWN";
        };

        tdSca: tap_shift_control_alt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LALT>, <&kp LS(LCTRL)>, <&kp LS(LALT)>, <&kp LC(LALT)>;
        };

        tdOpes1: tap_operators1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp JP_EQUAL>, <&kp JP_EXCLAMATION>, <&kp JP_QUESTION>;
        };

        tdOpes2: tap_operators2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp KP_PLUS>, <&kp KP_MINUS>, <&kp KP_MULTIPLY>, <&kp KP_SLASH>;
        };

        tdBits: tap_bit_operators {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp JP_AMPERSAND>, <&kp JP_PIPE>, <&kp JP_CARET>, <&kp JP_PERCENT>;
        };

        tdSymbols1: tap_symbols1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp JP_AT>, <&kp JP_HASH>, <&kp JP_DOLLAR>;
        };

        tdSymbols2: tap_symbols2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp JP_UNDERSCORE>, <&kp JP_TILDE>;
        };

        tdBrackets: tap_bracket_pairs {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LPAR>, <&kp LBKT>, <&kp LBRC>;
        };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                        &kp Q  &kp W     &kp E            &kp R          &kp T                          &kp Y      &kp U  &kp I      &kp O    &kp P
                        &kp A  &kp S     &kp D            &kp F          &kp G  &msc MB3   &kp DELETE   &kp H      &kp J  &kp K      &kp L    &moColon
            &kp BSPC    &kp Z  &kp X     &kp C            &kp V          &kp B             &kp ESC      &kp N      &kp M  &kp COMMA  &kp DOT  &kp SLASH
            &tdSca      &none  &kp LGUI  &lt 3 JP_HANZEN  &mt LCTRL TAB  &mt LSHIFT SPACE  &lt 1 ENTER  &lt 2 F13                             &kp JP_YEN
            >;

            sensor-bindings =
                <&scroll_up_down>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_1 {
            bindings = <
                        &tdBrackets  &mo7    &mo8     &mo9      &tdOpes1                          &tdSymbols1  &moPgTabUp   &kp UP    &moPgTabDown   &kp JP_AT
                        &kp KP_DOT   &mo4    &mo5     &mo6       &tdOpes2        &trans  &trans   &tdSymbols2  &kp LEFT     &kp DOWN  &kp RIGHT      &kp K_APP
            &trans      &mo0         &mo1    &mo2     &mo3       &tdBits                 &trans   &tdQuotes    &kp F15      &kp HOME  &kp END        &trans
            &trans      &trans       &trans  &trans   &trans     &trans                  &trans   &trans                                             &trans
            // &trans   &trans       &trans  &kp F14  &kp LG(V)  &kp LS(SPACE)           &trans   &kp LG(H)                                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            bindings = <
                      &kp F12  &kp F7  &kp F9  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
                      &kp F10  &kp F4  &kp F6  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans    &trans   &kp F1  &kp F2  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &maCtrlScrlUp
            &trans    &trans   &kp F1  &kp F2  &trans  &trans          &trans  &trans                          &kp LG(P)
            >;

            sensor-bindings = <&scroll_up_down>;
        };

         layer_3 {
             bindings = <
                       &tdBrackets &mo7     &mo8    &mo9      &tdOpes1                  &tdSymbols1  &maCtrlScrlUp   &kp SCRL_UP     &maCtrlScrlDown    &kp LG(P)
                       &kp KP_DOT  &mo4     &mo5    &mo6      &tdOpes2  &trans  &trans  &tdSymbols2  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT    &kp LG(LC(T))
             &trans    &mo0        &mo1     &mo2    &mo3      &tdBits           &trans  &quotes      &kp F21         &kp F22         &kp F23            &kp F24
             &trans    &trans      &trans   &trans  &trans    &trans            &trans  &trans                                                          &trans
             >;

             sensor-bindings = <&scroll_up_down>;
         };

    };
};
